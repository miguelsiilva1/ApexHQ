# Firebase web app config (Firebase console > Project settings > Your apps).
# Copy this file to .env.local and fill in the values. Without them the app runs with login disabled.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# DeepL API key for translating news to Portuguese (deepl.com/pro-api, the Free plan is enough).
# Server-side only: set it in Vercel (Project settings > Environment Variables) and here for `npm run dev`.
# Without it the news stay in English.
DEEPL_API_KEY=
